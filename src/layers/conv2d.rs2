use std::ops::Range;

use ndarray::{s, Array1, Array2, Array3, Array4, ArrayD, Axis, IxDyn, ViewRepr};
use rand::Rng;
use serde::{Deserialize, Serialize};
use crate::types::*;

#[derive(Serialize, Deserialize)]
pub struct Conv2d
{
    pub strides_len: (usize, usize), // stride length/interval
    pub strides_count: (usize, usize), // actual number of times to move by stride

    pub filter_sets: Array4<f64>,
    pub filter_set_grads: Array4<f64>,
    pub biases: ArrayD<f64>, // one bias per filter set/output channel
    pub bias_gradients: ArrayD<f64>,

    pub filter_dim: usize,

    pub input_tensors: ArrayD<f64>,
    pub summed_tensors: ArrayD<f64>,

    pub input_stride_buffer: ArrayD<f64>,
    pub in_channels: usize,
    pub out_channels: usize,
    pub l2: f64,
}
impl Conv2d
{
    pub fn new(
        in_channels: usize,
        out_channels: usize, 
        filter_dim: usize,
        stride_len: usize, 
        l2: f64
    ) -> Self
    {
        //let a: Array3<f64> = Array3::ones((3, 3, 3));
        //let b: Array4<f64> = Array4::ones((10, 3, 3, 3));
        //println!("{:?}", b.sum_axis(Axis(0)));
        //std::process::exit(1);
        //let start_y: usize = 0;
        //let end_y: usize = 1;
        //let start_x: usize = 1;
        //let end_x: usize = 2;
        //a.slice_mut(s![start_y..end_y + 1, start_x..end_x + 1]).zip_mut_with(&c, |av, cv| *av -= cv);

        // number of filter sets -> n output channels
        let mut filter_sets: Array4<f64> = 
            Array4::zeros((out_channels, in_channels, filter_dim, filter_dim));
        let filter_set_grads: Array4<f64> = 
            Array4::zeros((out_channels, in_channels, filter_dim, filter_dim));

            let range: f64 = (6.0 / (in_channels * filter_dim * filter_dim + out_channels) as f64).sqrt();
        // initialize filters with random values
        filter_sets.par_map_inplace(
            |val| 
            *val = rand::thread_rng().gen_range(-range..range)
        );

        // stores the sections of the input tensor as values that are
        // elementwise multiplied with the filters
        // used to speed up backpropagation

        return Self
        {
            filter_sets,
            filter_set_grads,
            strides_len: (stride_len, stride_len),
            filter_dim,

            // proper shapes initialized during the first ever forward pass called
            biases: ArrayD::zeros(IxDyn(&[0])),
            bias_gradients: ArrayD::zeros(IxDyn(&[0])),
            input_tensors: ArrayD::zeros(IxDyn(&[0])),
            summed_tensors: ArrayD::zeros(IxDyn(&[0])),
            input_stride_buffer: ArrayD::zeros(IxDyn(&[0])),
            in_channels,
            out_channels,
            strides_count: (0, 0),
            l2
        };

    }

    pub fn forward(&mut self, input_tensors: ArrayD<f64>) -> ArrayD<f64>
    {
        // if first time ever calling the forward method
        if self.input_tensors.shape() == &[0]
        {
            let input_shape: &[usize] = input_tensors.shape();
            self.input_tensors = ArrayD::zeros(IxDyn(input_shape));

            // calculate output shape
            let strides_count: (usize, usize) = 
                calculate_stride_counts(
                    (input_shape[1], input_shape[2]), 
                    self.filter_dim, self.strides_len
                );
            
            // initialize the tensors with the output shape
            self.summed_tensors = ArrayD::zeros(
                IxDyn(&[self.out_channels, strides_count.0, strides_count.1]
                ));

            self.biases = self.summed_tensors.clone();

            self.bias_gradients = self.summed_tensors.clone();

            self.strides_count = strides_count
        }
        
        // values in summed and activated are initialized to zero during
        // backpropagation when they are no longer needed
        self.input_tensors.fill(0.0);
        self.summed_tensors.fill(0.0);
        
        self.input_tensors += &input_tensors;

        // used for selection of sub 3D tensor ranges
        let in_chan_range: Range<usize> = 0..self.in_channels;
        let out_chan_range: Range<usize> = 0..self.out_channels;
        let mut start_y: usize = 0;
        let mut end_y: usize = self.filter_dim;
        let mut start_x: usize = 0;
        let mut end_x: usize = self.filter_dim;
        // calculate n times to move left and right depending
        // on filter and stride length

        // add weight sums
        //*weight_sum = self.filter_sets.map(|val| val.abs()).sum();
        //*squared_weight_sum = self.filter_sets.map(|val| val * val).sum();
        
        //println!("{:?}", self.summed_tensors.shape());
        //println!("{:?}", self.filter_sets.shape());

        let mut n_strides_passed: usize = 0;
        //let mut filter_weight_summed: bool = false;
        for stride_y in 0..self.strides_count.0
        {
            // will not require second loop for activated_vector
            for stride_x in 0..self.strides_count.1
            {
                // obtain 3d segment of image that corresponds with 3d
                // shape of each filter in 4d tensor
                let windowed_input = 
                    self.input_tensors.slice(
                        s![
                            in_chan_range.clone(), 
                            start_y..end_y,
                            start_x..end_x
                        ]
                    );
                                
                // write slice input tensor to ith 3d tensor in input_stride_buffer
                //let mut input_stride_buffer_slice = 
                //    self.input_stride_buffer.slice_mut(
                //        s![
                //            n_strides_passed..n_strides_passed + 1,
                //            in_chan_range.clone(), 
                //            0..self.filter_dim,
                //            0..self.filter_dim
                //        ]
                //    );

                // add windowed input to buffer
                //input_stride_buffer_slice += &windowed_input;
                n_strides_passed += 1;

                // perform 3D element wise multiplication 
                // (same sub input tensor broadcasted to each filter)
                let products_4d: Array4<f64> = &windowed_input * &self.filter_sets;

                // convert 4d tensor to vector of summed 3d tensors
                let mut summed_vector: Array3<f64> = products_4d
                    .sum_axis(Axis(1))
                    .sum_axis(Axis(1))
                    .sum_axis(Axis(1))
                    .insert_axis(Axis(1))
                    .insert_axis(Axis(1));
                    
                // obtain 1d segment of 3d bias tensor
                let bias_seg = 
                    self.biases.slice(
                        s![
                            out_chan_range.clone(),
                            stride_y..stride_y + 1,
                            stride_x..stride_x + 1
                        ]
                    );

                // add bias vector
                summed_vector += &bias_seg;
                
                // obtain 1d mutable segment of summed and activated matrices
                let mut summed_seg =
                    self.summed_tensors.slice_mut(
                        s![
                            out_chan_range.clone(),
                            stride_y..stride_y + 1,
                            stride_x..stride_x + 1
                        ]
                    );
                
                // add results to the mutable segments
                summed_seg += &summed_vector;
                
                // move window right
                start_x += self.strides_len.1;
                end_x += self.strides_len.1;
            }
                
            // move window down
            start_y += self.strides_len.0;
            end_y += self.strides_len.0;

            // move window back to left
            start_x = 0;
            end_x = self.filter_dim;
        }

        return self.summed_tensors.clone().into_dyn();

    }

    pub fn backward(&mut self, loss_r_summed: ArrayD<f64>) -> ArrayD<f64>
    {
        let mut loss_r_next_layer_activated: ArrayD<f64> = ArrayD::zeros(self.input_tensors.shape());

        // num output gradients matrices should equal number of filters/filter sets
        //println!("{:?}", self.input_shape);
        //println!("{:?}", self.output_shape);
        //println!("{:?}", obtain_shape_of_3d_mat(&gradients_3d));
        //println!("{:?}", obtain_shape_of_3d_mat(&self.filter_sets));
        //println!("{:?}", obtain_shape_of_3d_mat(&self.activated_tensors));
        //std::process::exit(1);

        // initialize sub tensor ranges
        let in_chan_range: Range<usize> = 0..self.in_channels;
        let out_chan_range: Range<usize> = 0..self.out_channels;
        let mut start_y: usize = 0;
        let mut end_y: usize = self.filter_dim;
        let mut start_x: usize = 0;
        let mut end_x: usize = self.filter_dim;
    
        // bias gradient is constant 1.0
        self.bias_gradients += &(1.0 * &loss_r_summed);

        // move filter through input matrices
        for stride_y in 0..self.strides_count.0
        {
            for stride_x in 0..self.strides_count.1
            {

                let loss_r_summed_slice = 
                    loss_r_summed.slice(
                        s![
                            out_chan_range.clone(),
                            stride_y..stride_y + 1,
                            stride_x..stride_x + 1
                        ]
                    ).to_owned();

                // first convert the 3d slice to 1d vector
                let loss_r_summed_slice = 
                    loss_r_summed_slice.into_shape(self.out_channels).unwrap();
                
                // add new axes to expand from 1d to 4d
                let loss_r_summed_slice = 
                    loss_r_summed_slice
                    .insert_axis(Axis(1))
                    .insert_axis(Axis(1))
                    .insert_axis(Axis(1));

                // broadcast values in third dimension into 3d versions
                let loss_r_summed_slice = 
                    loss_r_summed_slice.broadcast(
                    (self.out_channels, self.in_channels, self.filter_dim, self.filter_dim)
                    ).unwrap();
                    
                // calculate 3d filter gradient tensor
                // (gradient_r_summed * summed_to_filter_weights)
                let summed_to_filters = 
                    self.input_tensors.slice(
                        s![
                            in_chan_range.clone(), 
                            start_y..end_y,
                            start_x..end_x
                        ]
                    );
                
                // 3d multiplied broadcasted on 4d
                let filter_grad_temp: Array4<f64> = 
                    &summed_to_filters * &loss_r_summed_slice;
                
                self.filter_set_grads += &filter_grad_temp;


                // calculate new 3d gradients
                let summed_to_activated: &Array4<f64> = &self.filter_sets;
                
                let grad_prod: Array3<f64> = 
                    (summed_to_activated * &loss_r_summed_slice)
                    .sum_axis(Axis(0));

                let mut loss_r_next_layer_activated_slice = 
                    loss_r_next_layer_activated.slice_mut(
                    s![
                        in_chan_range.clone(), 
                        start_y..end_y,
                        start_x..end_x
                    ]
                );

                loss_r_next_layer_activated_slice += &grad_prod;

                // move window right
                start_x += self.strides_len.1;
                end_x += self.strides_len.1;
            }
            // move window down
            start_y += self.strides_len.0;
            end_y += self.strides_len.0;

            // move window back to left
            start_x = 0;
            end_x = self.filter_dim;
        }

        return loss_r_next_layer_activated;
    }

    pub fn update_params(&mut self, lr: f64)
    {
        self.filter_sets -= &(lr * (&self.filter_set_grads + self.l2 * &self.filter_sets));
        self.biases -= &(lr * &self.bias_gradients);
    }

    pub fn zero_grads(&mut self)
    {
        self.filter_set_grads.fill(0.0);
        self.bias_gradients.fill(0.0);
        self.input_stride_buffer.fill(0.0);
    }

    pub fn details(&self)
    {
        println!("Num input channels: {}", self.in_channels);
        println!("Num output channels: {}", self.out_channels);
        println!("Input shape: {:?}", self.input_tensors.shape());
        println!("Output shape: {:?}", self.summed_tensors.shape());
        println!("Filters: \n{:?}", self.filter_sets);
        println!("--------------------------------------");
        println!("Biases: \n{:?}", self.biases);
        println!("=======================================");
    }

}

fn init_filter_weights(dim: usize, weight_range: f64) -> (Vec<f64>, Vec<f64>)
{
    let mut filter: Vec<f64> = Vec::with_capacity(dim * dim);
    let mut filter_gradients: Vec<f64> = Vec::with_capacity(dim * dim);
    for _ in 0..(dim * dim)
    {
        let random_weight: f64 = rand::thread_rng().gen_range(-weight_range..=weight_range);
        filter.push(random_weight);
        filter_gradients.push(0.0);
    }

    return (filter, filter_gradients);
}

#[derive(Serialize, Deserialize)]
pub struct Window
{
    pub start_y: usize,
    pub end_y: usize,
    pub start_x: usize,
    pub end_x: usize
}
impl Window
{
    pub fn new(start_y: usize, end_y: usize, start_x: usize, end_x: usize) -> Self
    {
        return Self
        {
            start_y,
            end_y,
            start_x,
            end_x
        }
    }

    pub fn move_window_left(&mut self, stride: usize)
    {
        self.start_x += stride;
        self.end_x += stride;
    }

pub fn move_window_down(window: &mut Window2D, stride: usize)
{
    let smallest_x: usize = window[0].1; 
    for coord in window
    {
        coord.0 += stride; // move down by y stride
        coord.1 -= smallest_x; // translate x coordinate back to 0, 1, 2, ...
    }
}
}

fn move_window_down(window: &mut Window2D, stride: usize)
{
    let smallest_x: usize = window[0].1; 
    for coord in window
    {
        coord.0 += stride; // move down by y stride
        coord.1 -= smallest_x; // translate x coordinate back to 0, 1, 2, ...
    }
}

fn reset_window_coords(window: &mut Window2D)
{
    let smallest_y: usize = window[0].0; 
    let smallest_x: usize = window[0].1; 

    // translate x and y coordinates back to 0, 1, 2, ...
    for coord in window
    {
        coord.0 -= smallest_y; // translate y coordinate back to 0, 1, 2, ...
        coord.1 -= smallest_x; // translate x coordinate back to 0, 1, 2, ...
    }
}

fn flip_filter_weights(filter: &mut Vec<f64>)
{
    filter.reverse();
}


pub fn calculate_stride_counts(
    matrix2d_shape: (usize, usize), 
    filter_dim: usize, strides_len: (usize, usize)
) -> (usize, usize)
{
    let n_strides_vertical: f64 = 
        ((matrix2d_shape.0 as f64 - filter_dim as f64) / 
            strides_len.0 as f64 + 1.0).floor();

    let n_strides_side: f64 = 
        ((matrix2d_shape.1 as f64 - filter_dim as f64) / 
            strides_len.1 as f64 + 1.0).floor();
    
    return (n_strides_vertical as usize, n_strides_side as usize);
}
