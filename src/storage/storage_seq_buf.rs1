#[derive(Debug)]
pub struct MemoryMap
{
    mmap: Option<MmapMut>,
    byte_len: usize,
    mmap_file_path: String
}
impl MemoryMap
{
    pub fn new(initial_bytes: Vec<u8>) -> Self
    {
        let random_path: String = "memory".to_string() + "/" + gen_random_name(15).as_str();
        let file: File = OpenOptions::new()
            .create(true)
            .write(true)
            .read(true)
            .open(random_path.clone()).unwrap();
        
        file.set_len(100000 as u64).unwrap();
        let mut mmap: MmapMut = unsafe { 
            MmapMut::map_mut(&file).unwrap() 
        };

        let byte_len: usize = initial_bytes.len();
        mmap[0..byte_len].copy_from_slice(&initial_bytes);
        mmap.flush().unwrap();

        return Self
        {
            mmap: Some(mmap),
            byte_len,
            mmap_file_path: random_path
        };
    }

    pub fn write_bytes(&mut self, bytes: Vec<u8>)
    {
        let new_byte_len: usize = bytes.len();
        if new_byte_len > self.byte_len
        {
            self.clear_mmap();
            // remap file with more bytes
            let file: File = OpenOptions::new()
                .create(true)
                .write(true)
                .read(true)
                .open(self.mmap_file_path.clone()).unwrap();
        
            file.set_len(new_byte_len as u64).unwrap();

            // reassign mmap
            self.mmap = unsafe {
                Some(MmapMut::map_mut(&file).unwrap())
            };
        }

        self.byte_len = new_byte_len;
        let mmap: &mut MmapMut = self.mmap.as_mut().unwrap();
        mmap[0..self.byte_len].copy_from_slice(&bytes);
        mmap.flush().unwrap();

    }

    pub fn clear_mmap(&mut self)
    {
        self.mmap = None;
    }

    pub fn read_bytes(&self) -> &[u8]
    {
        return &self.mmap.as_ref().unwrap()[0..self.byte_len];
    }
}

pub struct MemoryBuf
{
    // constantly appending/popping inputs/outputs
    online_count: u128,
    online_input_seq: VecDeque<ArrayD<u16>>,
    online_output_seq: VecDeque<ArrayD<u16>>,
    online_reward_seq: VecDeque<f32>,
    online_choice_type: VecDeque<f32>, // 0 = from pred, 1 = random action
    online_ae_loss_seq: VecDeque<f32>,
    online_reward_sum: f32,
    online_choice_sum: f32, // plus one if action was not desired action


    //seq_maps: Vec<MmapMut>,
    //seqs: Vec<Vec<u8>>,
    //ratings: Vec<f32>,
    seq_heap_dict: HeapDict<f32, Vec<u8>>,
    seq_in_use: DataSeq,
    seq_byte_lens: Vec<usize>,
    // to be used for random selection on heap array
    // weights based on heap level
    //cumul_level_weights: Vec<f32>,
    //idx_level_cat: Vec<Vec<usize>>,

    //max_storage_len: usize,
    max_seq_len: usize,
    max_storage_len: usize,
    current_idx: i32,
    ascend: bool,
}

impl MemoryBuf
{
    pub fn new(max_storage_len: usize, max_seq_len: usize) -> Self
    {
        let seq_storage: MemoryBuf = Self
        {
            online_count: 0,
            online_input_seq: VecDeque::new(),
            online_output_seq: VecDeque::new(),
            online_reward_seq: VecDeque::new(),
            online_choice_type: VecDeque::new(),
            online_ae_loss_seq: VecDeque::new(),
            online_reward_sum: 0.0,
            online_choice_sum: 0.0,
            
            //seq_maps: Vec::new(),
            //seqs: Vec::new(),
            //ratings: Vec::new(),
            seq_in_use: DataSeq::new(VecDeque::new(), VecDeque::new()),
            seq_heap_dict: HeapDict::new(),
            seq_byte_lens: Vec::new(),

            max_seq_len, max_storage_len,
            ascend: true,
            current_idx: 0,
        };

        return seq_storage;
    }

    pub fn add_to_online_seq(&mut self, input: ArrayD<f32>, output: ArrayD<f32>, reward: f32, choice_type: f32, ae_loss: f32)
    {   
        // add to online sequence
        self.online_input_seq.push_back(input.mapv(|v: f32| f16::from_f32(v).to_bits()));
        self.online_output_seq.push_back(output.mapv(|v: f32| f16::from_f32(v).to_bits()));
        self.online_reward_seq.push_back(reward);
        self.online_choice_type.push_back(choice_type);
        self.online_ae_loss_seq.push_back(ae_loss);
        self.online_reward_sum += reward;
        self.online_choice_sum += choice_type;

        if self.online_input_seq.len() > self.max_seq_len
        {
            self.online_input_seq.pop_front();
            self.online_output_seq.pop_front();
            let reward: f32 = self.online_reward_seq.pop_front().unwrap();
            let choice: f32 = self.online_choice_type.pop_front().unwrap();
            self.online_ae_loss_seq.pop_front();

            self.online_reward_sum -= reward;
            self.online_choice_sum -= choice;
        }

        // prefer sequences with more random actions = more diverse buffer
        // prefer sequences that are longer
        //if self.seq_heap_dict.len() == 0 || 
        //    (self.online_choice_sum >= self.online_input_seq.len() as f32 * 0.25)// &&
             //rand::thread_rng().gen_range(0.0..1.0) < 0.1)
        {
            let rating: f32 = 
                //(self.online_reward_sum / self.online_reward_seq.len() as f32) + 
                //self.online_reward_seq.len() as f32;
                self.online_reward_sum + self.online_reward_seq.len() as f32;
            
            // record copy of current online sequences and save to disk
            //let random_name: String = gen_random_name(20);
            let new_data_seq: DataSeq = DataSeq::new(
                self.online_input_seq.clone(), 
                self.online_output_seq.clone()
            );

            if self.seq_heap_dict.len() >= self.max_storage_len
            {
                let first_node: &mut HeapNode<f32, Vec<u8>> = self.seq_heap_dict.mut_ref_at(0);
                let lowest_rating: f32 = first_node.key;
                if rating >= lowest_rating
                {
                    //let first_ref: &mut HeapNode<f32, Vec<u8>> = self.seq_heap_dict.mut_ref_at(0);
                    //first_node.key = rating;
                    //first_node.data.write_bytes(serialized_seq);
                    //self.seq_heap_dict.trickle_down();
                    let serialized_seq: Vec<u8> = bincode::serialize(&new_data_seq).unwrap().to_vec();
                    self.seq_heap_dict.replace_first(rating, serialized_seq);
                }
            }
            else
            {
                let serialized_seq: Vec<u8> = bincode::serialize(&new_data_seq).unwrap().to_vec();
                //let memory_map: MemoryMap = MemoryMap::new(serialized_seq);
                self.seq_heap_dict.add(rating, serialized_seq);
            }
        }
        /**/
    }

    //pub fn get_seq_rating_at(&mut self, idx: usize) -> f32
    //{
        //let memorymap: &MmapMut = self.seq_maps.get(idx).unwrap();
        //let seq: DataSeq = read_seq_from_mem(memorymap, self.seq_byte_lens[idx]);

    //    let rating: f32 = self.ratings[idx];
        //self.ratings[idx] -= 0.1;       
    //    return rating;
    //}

    pub fn mov_seq_idx(&mut self) -> usize
    {
        let current_idx: usize = self.current_idx as usize;
        
        if self.current_idx == 0
        {
            // allows new entries to be accepted while allowing
            // current data to still be trained on
            for node in &mut self.seq_heap_dict.heap_vec
            {
                //node.key = f32::NEG_INFINITY;
            }
        }

        if self.current_idx >= self.seq_heap_dict.len() as i32 - 1
        {
            self.current_idx = self.seq_heap_dict.len() as i32 - 1;
            self.ascend = false;
        }
        else if self.current_idx <= 0
        {
            self.current_idx = 0;
            self.ascend = true;
        }

        if self.seq_heap_dict.len() > 1
        {
            if self.ascend
            {
                self.current_idx += 1;
            }
            else
            {
                self.current_idx -= 1;
            }
        }
        //println!("{:?}, {:?}", self.ascend, self.current_idx);

        self.current_idx = rand::thread_rng().gen_range(0..self.seq_heap_dict.len()) as i32;

        return current_idx;
    }

    pub fn update_saved_seq(&mut self)
    {
        //let serialised_seq: &[u8] = 
        //    self.seq_heap_dict.heap_vec[self.current_idx as usize].data.read_bytes();
        let serialised_seq: Vec<u8> = self.seq_heap_dict.heap_vec[self.current_idx as usize].value.clone();

        let seq: DataSeq = bincode::deserialize(
            &serialised_seq
        ).unwrap();

        self.seq_in_use = seq;
    }

    pub fn get_saved_seq_len(&self) -> usize
    {
        return self.seq_in_use.input_seq.len();
    }

    pub fn get_saved_inputs_at(&self, inputs_idx: usize) -> ArrayD<f32>
    {
        //let memorymap: &MmapMut = self.seq_maps.get(seq_idx).unwrap();
        //let seq: DataSeq = read_seq_from_mem(
        //    memorymap, self.seq_byte_lens[seq_idx]
        //);
        //let serialized: &Vec<u8> = self.seqs.get(seq_idx).unwrap();
        //let seq: &DataSeq = self.seqs.get(seq_idx).unwrap();
        let input_array: ArrayD<u16> = 
            self.seq_in_use.input_seq.get(inputs_idx).unwrap().clone();
        
        return input_array.mapv(|v: u16| f16::from_bits(v).to_f32());
    }

    pub fn get_saved_outputs_at(&self, outputs_idx: usize) -> ArrayD<f32>
    {
        //let memorymap: &MmapMut = self.seq_maps.get(seq_idx).unwrap();
        //let seq: DataSeq = read_seq_from_mem(
        //    memorymap, self.seq_byte_lens[seq_idx]
        //);
        //let serialized: &Vec<u8> = self.seqs.get(seq_idx).unwrap();
        //let seq: &DataSeq = self.seqs.get(seq_idx).unwrap();
        let output_array: ArrayD<u16> = 
            self.seq_in_use.output_seq.get(outputs_idx).unwrap().clone();
        
        return output_array.mapv(|v: u16| f16::from_bits(v).to_f32());
    }

    pub fn clear_online(&mut self)
    {  
        self.online_input_seq.clear();
        self.online_output_seq.clear();
        self.online_reward_seq.clear();
        self.online_choice_type.clear();
        self.online_count = 0;
        self.online_reward_sum = 0.0;
        self.online_choice_sum = 0.0;
    }

    pub fn get_ave_rating(&mut self) -> f32
    {
        //let mut rating_sorted: Vec<f32> = self.ratings.clone();
        //rating_sorted.sort_by(|a, b| a.partial_cmp(b).unwrap());
        //let q1_idx: usize = (rating_sorted.len() + 1) * (1 / 4);

        let mut rating: f32 = 0.0;
        for i in 0..self.seq_heap_dict.len()
        {
            rating += self.seq_heap_dict.heap_vec[i].key;
        }

        //return rating_sorted[q1_idx];//rating / (self.ratings.len() as f32);
        return rating / (self.seq_heap_dict.len() as f32);
    }

