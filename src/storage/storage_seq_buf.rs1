pub fn get_vec_min_max(vector: &[f32]) -> (usize, f32, usize, f32, f32)
{
    let mut min_val: f32 = vector[0];
    let mut min_idx: usize = 0;
    let mut max_val: f32 = vector[0];
    let mut max_idx: usize = 0;
    let mut total: f32 = vector[0];

    for i in 1..vector.len()
    {
        if vector[i] <= min_val
        {
            min_val = vector[i];
            min_idx = i;
        }

        if vector[i] >= max_val
        {
            max_val = vector[i];
            max_idx = i;
        }
        total += vector[i];
    }

    return (min_idx, min_val, max_idx, max_val, total);
}

pub fn _scale_vec(vector: &Vec<f32>, scale: f32) -> Vec<f32>
{   
    let (_, min_val, _, max_val, _) = get_vec_min_max(vector);
    let mut scaled_vector: Vec<f32> = Vec::new();
    let mut max_abs: f32 = 0.0;
    if min_val.abs() >= max_val.abs()
    {
        max_abs = min_val.abs();
    }
    else if min_val.abs() < max_val.abs() 
    {
        max_abs = max_val.abs();
    }

    for i in 0..vector.len()
    {
        scaled_vector.push((vector[i] / max_abs) * scale);
    }

    return scaled_vector;
}

pub fn _invert_weighting_vec(vector: &Vec<f32>) -> Vec<f32>
{
    let (_, min_val, _, max_val, _) = get_vec_min_max(vector);
    let mut inverted_vector: Vec<f32> = Vec::new();
    for i in 0..vector.len()
    {
        inverted_vector.push((min_val + max_val) - vector[i]);
    }
    return inverted_vector;
}

